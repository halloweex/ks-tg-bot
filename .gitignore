# Secrets — never commit
.env

# Local agent permissions. Records verbatim command lines, which have carried
# customer phone numbers as script arguments. A global ~/.config/git/ignore
# already covers it on this machine — that protection travels with the machine,
# not with the repository, so it is stated here too.
.claude/settings.local.json

# Server-specific backup target (see deploy/backup.env.example)
deploy/backup.env

# Local copies of database backups
backups/

# Virtual environment
.venv/

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Packaging artifacts
*.egg-info/
dist/
build/

# IDE
.idea/

# SQLite databases
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# macOS
.DS_Store

# Research working files
.planning/research/

