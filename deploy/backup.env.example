# Off-site backup target — copy to deploy/backup.env on the server and fill in.
# deploy/backup.env is git-ignored: it points at storage, not at secrets, but the
# SSH key path is server-specific.

# Hetzner Storage Box sub-account (Storage Box → Sub-accounts → create one with
# SSH enabled, readonly off, and its own directory). ~1 EUR/month for BX11.
#
# Note the host: a sub-account answers at its OWN name, not on the main
# account's. u123456-sub1@u123456.your-storagebox.de looks reasonable and is
# refused.
BACKUP_REMOTE=u123456-sub1@u123456-sub1.your-storagebox.de

# Where archives land, relative to where the login puts you. A sub-account with
# its own base directory is already inside it — its pwd is "/home" — so this is
# "." and not the directory's name, which would nest it inside itself. Set it to
# a name only if you point BACKUP_REMOTE at the main account instead.
BACKUP_REMOTE_DIR=.

# Storage Box listens for SSH/rsync/sftp on port 23, not 22.
BACKUP_SSH_PORT=23

# Key whose public half sits in <base-dir>/.ssh/authorized_keys on the box —
# there is no SSH-key field for sub-accounts in the console, only for the main
# account. Passphrase-less, so cron can use it unattended, which is exactly why
# the sub-account is scoped to one directory. See DEPLOY.md §6.1.
BACKUP_SSH_KEY=/root/.ssh/storagebox_ed25519

# How many archives to keep in each location (volume, host, Storage Box).
BACKUP_RETAIN=14

# Where host-side copies land.
BACKUP_HOST_DIR=/opt/ks-tg-bot/backups

# Who gets the Telegram alert when a backup fails. Optional: with this unset the
# script messages the first id in ADMIN_USER_IDS from .env, i.e. the main admin.
# BOT_TOKEN is read from .env too, so it is not duplicated here.
# BACKUP_ALERT_CHAT_ID=129462784
