BOT_TOKEN=your-telegram-bot-token
BOT_USERNAME=koreanstory_bot
KEYCRM_API_KEY=your-keycrm-api-key
SHOPIFY_API_TOKEN=
SHOPIFY_STORE_URL=
# One key is enough: any key tracks any parcel as long as the recipient phone is
# supplied, which the bot always has. Several may be listed comma-separated
# (no brackets, no quotes) and are used only as failover.
NOVAPOSHTA_API_KEY=
ADMIN_USER_IDS=129462784,183618567

# Log level (INFO in production; DEBUG logs buyer-profile sync failures).
LOG_LEVEL=INFO
# Key for the phone digests in the log. Without it the mask is reversible —
# ~10^9 Ukrainian numbers against a 24-bit digest enumerates in seconds.
# Generate once, never change: python -c "import secrets;print(secrets.token_hex(16))"
LOG_PHONE_SALT=

# Which grammatical form each customer is addressed in — Ukrainian marks the
# addressee's gender, and this shop has 777 male buyers among 20 145. The answer
# lives in `app.buyer_gender` in the warehouse's Postgres, which belongs to the
# neighbouring project (/opt/key-api-bot) and publishes a read-only role for
# exactly this kind of reader. Host is the container name: both projects share
# the `key-api-bot_default` network already, so nothing needs to be plugged in.
#
# Unset — which is how it ships — means no sweep, no column written, and every
# customer addressed the way core/texts.py is written. Turning it on needs the
# password of ks_readonly from /opt/key-api-bot/.env, and one grant if the table
# was not created by ks_app:  GRANT SELECT ON app.buyer_gender TO ks_readonly;
BUYER_GENDER_DSN=
