BOT_TOKEN=your-telegram-bot-token
BOT_USERNAME=koreanstory_bot
KEYCRM_API_KEY=your-keycrm-api-key
SHOPIFY_API_TOKEN=
SHOPIFY_STORE_URL=
# One key is enough: any key tracks any parcel as long as the recipient phone is
# supplied, which the bot always has. Several may be listed comma-separated
# (no brackets, no quotes) and are used only as failover.
NOVAPOSHTA_API_KEY=
ADMIN_USER_IDS=129462784,183618567

# Log level (INFO in production; DEBUG logs buyer-profile sync failures).
LOG_LEVEL=INFO
# Key for the phone digests in the log. Without it the mask is reversible —
# ~10^9 Ukrainian numbers against a 24-bit digest enumerates in seconds.
# Generate once, never change: python -c "import secrets;print(secrets.token_hex(16))"
LOG_PHONE_SALT=

# Which grammatical form each customer is addressed in — Ukrainian marks the
# addressee's gender, and this shop has 777 male buyers among 20 145. The answer
# lives in `app.buyer_gender` in the warehouse's Postgres, which belongs to the
# neighbouring project (/opt/key-api-bot) and publishes a read-only role for
# exactly this kind of reader. Host is the container name: both projects share
# the `key-api-bot_default` network already, so nothing needs to be plugged in.
#
# Unset — which is how it ships — means no sweep, no column written, and every
# customer addressed the way core/texts.py is written. Turning it on needs the
# password of ks_readonly from /opt/key-api-bot/.env, and one grant if the table
# was not created by ks_app:  GRANT SELECT ON app.buyer_gender TO ks_readonly;
BUYER_GENDER_DSN=

# The loyalty webhook: the only door into this bot from outside Telegram. Rivo
# posts here when somebody's points, tier or referral change, and the bot tells
# them in Telegram a minute later instead of by an email opened on Thursday.
#
# Two locks, and the endpoint refuses to open without both: the path carries a
# secret segment so it cannot be found by scanning, and the body carries an HMAC
# signature so a request to a known path still cannot be forged.
#
# Unset — which is how it ships — means no endpoint AND no watchdog: they are
# started by the same `if` in bot/__main__.py. That pair is deliberate (there is
# nothing to watch when there is no door) and it is also a trap: an .env rebuilt
# from this file turns off the channel and the only thing that would have said
# so. The route lives outside this repo, in the neighbouring project's nginx:
# lost three times to rewrites of that file, and since 2026-09-16 committed in
# their repository as a /rivo/ prefix block — docs/loyalty-webhook.md.
#
# RIVO_WEBHOOK_SECRET is the signing key: ONE for the whole Rivo account, shown at
# the bottom of Settings → Webhooks ("Your webhooks will be signed with …"),
# whatever Rivo's documentation implies about a key per webhook. Several may be
# listed comma-separated, no quotes — that is for rotating the key without a gap.
# A blank entry is ignored, never used as a key.
#
# RIVO_WEBHOOK_PATH is the secret path, /rivo/<32 hex>. The neighbouring nginx
# forwards the whole /rivo/ prefix and the bot checks the path itself, so nginx
# never needs to know it. Several may be listed comma-separated — the new path
# first, the old one after it — while the URLs are being changed in the Rivo
# cabinet. Only entries starting with /rivo/ become routes.
RIVO_WEBHOOK_SECRET=
RIVO_WEBHOOK_PATH=
